# Ajoy Tools: every secret the project needs, with placeholders only.
# Copy this file to .env for local scripts. NEVER commit .env or put real values in this file.
#
# This website is static (GitHub Pages) and has no build step, so nothing here is read by the browser.
# Real values live in two private places:
#   [S] Supabase  ->  Project Settings > Edge Functions > Secrets  (or: supabase secrets set NAME=value)
#   [A] Apps Script -> Project Settings > Script properties
# The browser only ever receives public values (see js/site-config.js: the Supabase function URLs and the Apps Script web-app URL).

# ---------- [S] Supabase (Edge Functions) ----------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-public-anon-or-publishable-key        # public by design; safe only because every table has RLS on
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key              # SERVER ONLY. Never in js/, html or any browser code
COMMERCE_SECRET=generate-32-plus-random-bytes
TRIAL_IDENTITY_SECRET=generate-32-plus-random-bytes
QUOTE_SIGNING_SECRET=generate-32-plus-random-bytes
SHEET_WEB_APP_URL=https://script.google.com/macros/s/YOUR-DEPLOYMENT-ID/exec
ALLOWED_ORIGINS=https://your-site.example
COMMERCE_ENABLED=true
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_PLANS={"basic":{"monthly":"P-XXXX"}}
PAYPAL_CLOSED_COUNTRIES=
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=generate-16-plus-random-chars
BILLING_VPN_ENABLED=false
BILLING_VPN_API_KEY=your-proxycheck-key-if-used
COUPONS_JSON={}
INSTALLER_BUCKET=installers
INSTALLER_OBJECT=AjoyTools_Setup.py
COMMERCE_SANDBOX_COUNTRY=
COMMERCE_CLIENT_IP_HEADER=
DEFAULT_COUNTRY=
LOYALTY_ENABLED=true

# ---------- [A] Apps Script properties ----------
COMMERCE_SECRET=same-value-as-the-supabase-secret-above
TRIAL_IDENTITY_SECRET=same-value-as-the-supabase-secret-above
SESSION_SECRET=generate-32-plus-random-bytes
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_SECRET=your-paypal-secret
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=same-value-as-the-razorpay-dashboard-webhook
CONTACT_GITHUB_REPO=owner/private-repo-for-contact-attachments
CONTACT_GITHUB_TOKEN=your-fine-grained-github-token          # contents:write on that one private repo only
OWNER_EMAIL=you@example.com                                  # where order reminders go
REPLY_TO=support@example.com                                 # address buyers can reply to
BILLING_TESTER_EMAIL=you@example.com                         # the one account allowed to test another billing country
INVOICE_SELLER_NAME=Your Name
INVOICE_SELLER_DETAILS=Your address and tax details
PAYMENT_LEDGER=your-ledger-sheet-id
